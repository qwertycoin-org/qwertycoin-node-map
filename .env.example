# Internal unrestricted Qwertycoin Core RPC. Do not expose this endpoint publicly.
QWC_RPC_BASE_URL=http://qwc-daemon:8197
QWC_RPC_AUTH=none
# QWC_RPC_USERNAME_FILE=/run/secrets/qwc_rpc_username
# QWC_RPC_PASSWORD_FILE=/run/secrets/qwc_rpc_password

QWC_EXPECTED_CORE_VERSION=2.0.2-release
QWC_EXPECTED_GENESIS_HASH=4f95857586e2c66063c277370eda99cd75897d773af09f0c3cd1e22f7e87db39
POLL_INTERVAL_SECONDS=300
STALE_AFTER_SECONDS=900

DATA_DIR=/data
GEOIP_DB_PATH=/data/geoip/dbip-city-lite.mmdb
GEOIP_AUTO_UPDATE=true

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HOST_HTTP_PORT=18082
PUBLIC_BASE_PATH=
CORS_ALLOWED_ORIGINS=

# Existing private Docker network that contains the QWC daemon.
QWC_DOCKER_NETWORK=qwc-mainnet-backend
